                        <i class="fas fa-shield-halved"></i>
                    </div>
                </div>
                
                <div class="why-features-column">
                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="fas fa-user-gear"></i>
                        </div>
                        <div class="feature-content">
                            <h3>EXPERIENCED TECHNICIANS</h3>
                            <p>Skilled professionals with years of hands-on experience.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="far fa-clock"></i>
                        </div>
                        <div class="feature-content">
                            <h3>FAST & RELIABLE SERVICE</h3>
                            <p>Quick turnaround times without compromising on quality.</p>
                        </div>
                    </div>

                    <div class="feature-item">
                        <div class="feature-icon">
                            <i class="far fa-handshake"></i>
                        </div>
                        <div class="feature-content">
                            <h3>CUSTOMER SATISFACTION</h3>
                            <p>Your satisfaction is our priority. We deliver results you can trust.</p>
                        </div>
                    </div>
                </div>
            </div>
