/* --- Global Resets & Typography --- */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Helvetica Neue', Arial, sans-serif;
}

body {
    background-color: #000000;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* --- Shared Header Banner Area --- */
.banner-header {
    background: linear-gradient(to right, rgba(162, 210, 255, 0.45), rgba(0, 50, 150, 0.15)), 
                url('Leon\ Banner.jpg') no-repeat center center;
    background-size: cover;
    height: 380px;
    padding: 20px 6%;
    display: flex;
    justify-content: flex-start; 
    align-items: flex-start;
    width: 100%;
}

.logo-area {
    max-width: 220px;
    margin: 0; 
    display: flex;
    flex-direction: column;
    align-items: center;    
    text-align: center;    
}

.brand-logo {
    width: 100%;
    height: auto;
    display: block;
    background: transparent;
    margin-bottom: 4px;   
}

.tagline {
    color: #0b2bf0; 
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
    text-align: center;    
    width: 100%;
    margin-top: 0;
}

/* --- Main Structure Overriding Base Layout --- */
.main-body {
    background-color: #cccccc; 
    border-top-left-radius: 45px;
    border-top-right-radius: 45px;
    margin-top: -60px; 
    padding: 45px 6% 60px 6%;
    flex-grow: 1;
    position: relative;
    z-index: 5;
}

/* --- Navigation Links Layout --- */
.navigation-menu {
    display: flex;
    justify-content: center;
    gap: 35px;
    margin-bottom: 50px;
}

.navigation-menu a {
    text-decoration: none;
    color: #444444;
    font-weight: bold;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    padding-bottom: 6px;
    transition: color 0.2s ease;
}

.navigation-menu a:hover,
.navigation-menu a.active-link {
    color: #0b2bf0;
}

.navigation-menu a.active-link {
    border-bottom: 2px solid #0b2bf0; 
}

/* --- Intro Section Styles --- */
.intro-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto 60px auto;
}

.intro-text h2 {
    font-size: 2rem;
    font-weight: 800;
    color: #111111;
    letter-spacing: -0.5px;
    line-height: 1.2;
}

.highlight-red {
    color: #cc0000;
}

.red-line-short {
    width: 50px;
    height: 3px;
    background-color: #cc0000;
    margin: 15px 0 20px 0;
}

.intro-text p {
    color: #333333;
    font-size: 1.05rem;
    line-height: 1.6;
    text-align: justify;
}

.intro-image-container {
    border: 3px solid #0b2bf0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    display: flex;
}

.intro-image {
    width: 100%;
    height: auto;
    object-fit: cover;
    display: block;
}

/* --- Our Services Grid Section --- */
.services-section {
    max-width: 1100px;
    margin: 0 auto 60px auto;
}

.section-title-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 40px;
}

.section-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #111111;
    white-space: nowrap;
}

.title-line {
    flex-grow: 1;
    height: 1px;
    background: linear-gradient(to right, rgba(204,0,0,0), rgba(204,0,0,0.8), rgba(204,0,0,0));
}

.services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
}

.service-card {
    background-color: #ffffff;
    border-radius: 18px;
    padding: 30px 20px;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    display: flex;
    flex-direction: column;
    align-items: center;
}

.service-icon-circle {
    width: 80px;
    height: 80px;
    background-color: #0b2bf0;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
}

.service-icon-circle i {
    color: #ffffff;
    font-size: 2.2rem;
}

.service-card h3 {
    font-size: 1.05rem;
    color: #111111;
    font-weight: 700;
    letter-spacing: -0.2px;
}

.red-line-tiny {
    width: 25px;
    height: 2px;
    background-color: #cc0000;
    margin: 10px 0;
}

.service-card p {
    color: #555555;
    font-size: 0.9rem;
    line-height: 1.4;
}

/* --- Why Choose Us Structural Layout --- */
.why-choose-us {
    max-width: 1100px;
    margin: 0 auto;
    border-top: 1px solid #b5b5b5;
    padding-top: 40px;
}

.why-wrapper {
    display: grid;
    grid-template-columns: 35% 65%;
    gap: 40px;
}

.why-title-column h2 {
    font-size: 1.5rem;
    color: #111111;
    font-weight: 700;
}

.shield-icon-container {
    margin-top: 20px;
    color: #0b2bf0;
    font-size: 4.5rem;
}

.why-features-column {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 25px;
    border-left: 1px solid #b5b5b5;
    padding-left: 40px;
}

.feature-item {
    display: flex;
    align-items: flex-start;
    gap: 20px;
}

.feature-icon {
    color: #0b2bf0;
    font-size: 2.2rem;
    margin-top: 2px;
}

.feature-content h3 {
    font-size: 1.05rem;
    color: #111111;
    font-weight: 700;
    margin-bottom: 6px;
}

.feature-content p {
    color: #444444;
    font-size: 0.95rem;
    line-height: 1.4;
}

/* --- Shared Footer Styles --- */
.page-footer {
    background: linear-gradient(to bottom, #800202 0%, #170000 18%, #000000 100%);
    color: #ffffff;
    padding: 50px 8%;
    border-top: 1px solid #900000;
}

.footer-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    gap: 40px;
}

.footer-column h2 {
    font-size: 1.3rem;
    font-weight: 500;
    letter-spacing: 0.5px;
    margin-bottom: 25px;
}

.info-list {
    list-style: none;
}

.info-list li {
    font-size: 1.1rem;
    margin-bottom: 16px;
    color: #ffffff;
    display: flex;
    align-items: center;
}

.info-list i {
    width: 25px;
    font-size: 1.1rem;
}

/* --- Mobile Breakpoints & Responsiveness --- */
@media (max-width: 992px) {
    .services-grid {
        grid-template-columns: repeat(2, 1fr);
    }
    .why-wrapper {
        grid-template-columns: 1fr;
    }
    .why-features-column {
        border-left: none;
        padding-left: 0;
    }
}

@media (max-width: 768px) {
    .banner-header {
        height: 280px;
        justify-content: center; 
        text-align: center;
    }
    
    .logo-area {
        margin: 0 auto;
    }

    .main-body {
        margin-top: -40px;
        padding: 30px 5%;
    }

    .navigation-menu {
        gap: 15px;
        flex-wrap: wrap;
    }

    .intro-section {
        grid-template-columns: 1fr;
        gap: 30px;
    }

    .services-grid {
        grid-template-columns: 1fr;
    }

    .footer-grid {
        flex-direction: column;
        gap: 30px;
    }
}
